	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Workout File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openbike.zwo</string>
				<string>com.openbike.erg</string>
				<string>com.openbike.mrc</string>
				<string>com.garmin.fit</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Route File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
				<string>com.garmin.tcx</string>
			</array>
		</dict>
	</array>
